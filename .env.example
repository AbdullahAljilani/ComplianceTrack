# Copy to .env and adjust. .env is git-ignored and must never be committed.

# Required. A long random value: python -c "import secrets; print(secrets.token_hex(32))"
# serve.py refuses to start with this placeholder or anything under 32 characters.
FLASK_SECRET_KEY=change-this-to-a-long-random-value

# PostgreSQL connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=compliancetrack
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password

# Optional. Folder for evidence files, outside the web root. Defaults to
# evidence_store\ inside the project folder.
# EVIDENCE_ROOT=

# development (python app.py), demo or production (python serve.py).
APP_ENV=development
# 1 turns on Flask debug mode for python app.py. Never set it on a served instance.
FLASK_DEBUG=0
# true lists the synthetic demonstration accounts on the sign-in page.
SHOW_DEMO_ACCOUNTS=true
# true once the application is served over HTTPS (required when APP_ENV=production).
SESSION_COOKIE_SECURE=false

# serve.py only.
APP_HOST=127.0.0.1
APP_PORT=8080
WAITRESS_THREADS=8
# Address of a reverse proxy that terminates HTTPS, if there is one.
# TRUSTED_PROXY=127.0.0.1
